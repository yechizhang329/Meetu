{
  "name": "duty-room-v1",
  "private": true,
  "version": "1.0.0-alpha.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:oss": "tsc -b && SA_DEPLOY_TARGET=oss vite build --outDir dist-oss",
    "lint": "eslint .",
    "preview": "vite preview",
    "verify:canvas": "npx tsx scripts/verify-canvas-dims.ts",
    "qa:mouthpiece": "npx tsx scripts/qa-mouthpiece-samples.ts",
    "qa:h5": "npx tsx scripts/qa-h5-pages.ts",
    "qa:batch": "npx tsx scripts/qa-batch-32.ts",
    "qa:no-placeholder": "node scripts/qa-no-placeholder.cjs",
    "qa:asset-magenta": "node scripts/qa-asset-magenta.cjs",
    "deploy:gh": "npm run build && rm -rf ../../../docs/duty-room-v1/duty-room-v1/receipts-staging-whitelist-v1 && cp -R dist/* ../../../docs/duty-room-v1/"
  },
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "pngjs": "^7.0.0",
    "puppeteer": "^24.43.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  }
}
